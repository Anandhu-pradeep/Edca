# Copy this file to .env.local for local development
# Copy this file to .env.production for production builds
# Do NOT commit .env.local or .env.production to git

# For local development:
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/v1/events
# NEXT_PUBLIC_WS_HOST=localhost:8080

# For production:
# NEXT_PUBLIC_API_URL=https://api.anandhupradeep.com/api/v1
# NEXT_PUBLIC_WS_URL=wss://api.anandhupradeep.com/ws/v1/events
# NEXT_PUBLIC_WS_HOST=api.anandhupradeep.com

NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_WS_HOST=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
